{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "jupiterapp-dog.vercel.app" }],
      "destination": "https://www.appsbysass.com/jupiter-walkies/",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "bo-flax.vercel.app" }],
      "destination": "https://www.appsbysass.com/bo/",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "destination": "https://www.appsbysass.com/",
      "permanent": true
    }
  ]
}
